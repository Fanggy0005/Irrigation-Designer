# Development image for the Laravel app (PHP 8.3 CLI, as in CI). SQLite support is built in.
FROM docker.io/library/php:8.3-cli-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends git unzip libicu-dev libzip-dev \
    && docker-php-ext-install -j"$(nproc)" intl zip bcmath opcache pcntl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=docker.io/library/composer:2 /usr/bin/composer /usr/bin/composer

COPY php.ini "$PHP_INI_DIR/conf.d/zz-app.ini"
COPY entrypoint.sh /usr/local/bin/app-entrypoint
RUN chmod +x /usr/local/bin/app-entrypoint

WORKDIR /var/www/html

ENTRYPOINT ["app-entrypoint"]
# --no-reload: without it `artisan serve` drops the container's env vars (DB_DATABASE, ...)
# from the PHP server process, which then falls back to the host-oriented values in .env.
CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8000", "--no-reload"]
